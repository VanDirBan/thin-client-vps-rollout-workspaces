[Unit]
Description=WorkMon worker encrypted X11 screenshot capture agent
Documentation=file:/opt/workmon/README.md file:/opt/workmon/ARCHITECTURE.md
After=display-manager.service graphical.target
Wants=graphical.target

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/workmon
ExecStart=/usr/bin/python3 /opt/workmon/capture.py
Restart=always
RestartSec=10s
RuntimeDirectory=workmon
RuntimeDirectoryMode=0700
StateDirectory=workmon
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
# X11 capture needs the real /tmp/.X11-unix socket and user Xauthority access.
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/workmon
ReadOnlyPaths=/opt/workmon /etc/workmon
# This agent does no network I/O; block IP traffic as defense-in-depth.
IPAddressDeny=any
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
