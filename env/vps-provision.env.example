# Copy values into your environment before running scripts/vps-provision.sh
# or scripts/admin/vps-provision-launcher.sh.
#
# Do not commit real passwords, WireGuard keys/endpoints, private SSH keys,
# hoster details, or site-specific addresses.

export ADMIN_USER="adams"
export ADMIN_PASS="CHANGE_ME_ADMIN_PASS"
export WORK_USER="smm"
export WORK_PASS="CHANGE_ME_WORK_PASS"

# Empty string means leave the VPS default timezone unchanged.
export TIMEZONE="Europe/Berlin"

# WireGuard: this VPS acts as a client of an existing WG network.
# The provisioner always generates /etc/wireguard/vps_private.key and
# /etc/wireguard/vps_public.key. wg0.conf is written and started only when both
# WG_SERVER_PUBKEY and WG_SERVER_ENDPOINT are set.
export WG_ADDRESS="10.8.0.101/24"
export VPS_OCTET_MIN="101"
export VPS_OCTET_MAX="200"
export WG_SERVER_PUBKEY=""
export WG_SERVER_ENDPOINT=""
export WG_ALLOWED_IPS="10.8.0.0/24"
export WG_KEEPALIVE="25"

# Audio tunnel from VPS to a paired thin-client laptop.
# The laptop must be provisioned with local-provision.sh so PipeWire listens on
# the WireGuard-side TCP port. Leave AUDIO_LAPTOP_IP empty to skip the tunnel.
export LAPTOP_OCTET_MIN="6"
export LAPTOP_OCTET_MAX="99"
export AUDIO_TUNNEL_ENABLE="no"
export AUDIO_LAPTOP_IP=""
export AUDIO_TCP_PORT="4713"

# Prometheus node_exporter is bound only to this VPS's WireGuard IP.
# It may restart until wg0 is up; it should not listen on the public IP.
export NODE_EXPORTER_ENABLE="yes"
export NODE_EXPORTER_PORT="9100"

# NoMachine package pin.
export NOMACHINE_BRANCH="9.7"
export NOMACHINE_VERSION="9.7.3"
export NOMACHINE_BUILD="1"

# Windows-10 theme pins, kept in sync with local-provision.sh.
export WIN10_THEME_COMMIT="3a4116603b66a9adcb78f3987d7ea6f01de1cbce"
export WIN10_ICONS_COMMIT="9f199c6b7c6050f36d0d15aaa6e9f4847e8b9066"
