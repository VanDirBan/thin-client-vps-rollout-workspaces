# Copy values into your environment before running scripts/local-provision.sh.
# Do not commit real secrets or infrastructure-specific keys.

# Required per machine
export NEW_HOSTNAME="tc-05"
export WG_CLIENT_ADDR="10.8.0.5/24"

# Users
export ADMIN_USER="adams"
export SVC_USER="smm"
export SVC_USER_PASSWORD="CHANGE_ME_ON_FIRST_RUN"
export TARGET_USER="adams"
export ADMIN_GROUP="sudo"

# SSH collector access for the admin node
export COLLECT_PUBKEY="ssh-ed25519 REPLACE_WITH_COLLECT_PUBLIC_KEY workmon-collect"

# WorkMon installer directory located next to scripts/local-provision.sh
export WORKMON_AGENT_DIRNAME="workmon-agent-0.4.0"

# WireGuard
export WG_IFACE="wg0"
export WG_SERVER_PUBKEY="REPLACE_WITH_WG_SERVER_PUBLIC_KEY"
export WG_ENDPOINT="vpn.example.com:51820"
export WG_ALLOWED="0.0.0.0/0, ::/0"
export WG_KEEPALIVE="25"
export WG_AUTOSTART="yes"
export WG_WATCHDOG_MAX_AGE="180"

# NoMachine package pin
export NOMACHINE_BRANCH="9.7"
export NOMACHINE_VERSION="9.7.3"
export NOMACHINE_BUILD="1"
export NOMACHINE_MD5="8af5efe7b8ad3872a4681c4acf551b62"

# Windows-10 theme pins
export WIN10_THEME_COMMIT="3a4116603b66a9adcb78f3987d7ea6f01de1cbce"
export WIN10_ICONS_COMMIT="9f199c6b7c6050f36d0d15aaa6e9f4847e8b9066"
